# Rendered at container start by the nginx image's envsubst step.
# Variables: PORT (Cloud Run sets it) and API_UPSTREAM (e.g. https://pos-api-xxxx.run.app).

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Same-origin API: the browser never talks to the API host directly, so the session
    # cookie stays first-party and no CORS configuration exists.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA fallback; index.html must always be revalidated so new releases load.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
